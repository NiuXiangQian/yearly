# 本地运行的测试环境，数据库名必须以 _test 结尾
APP_ENV=test
DATABASE_URL=mysql+pymysql://yearly_test_app:CHANGE_ME@127.0.0.1:3306/yearly_test?charset=utf8mb4
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://127.0.0.1:5173
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 已备案、已绑定 OSS 的 HTTPS 自定义域名。留空使用地域 endpoint。
OSS_CUSTOM_DOMAIN=
# 同地域 ECS 的后台预览任务可使用内网 Endpoint。
OSS_INTERNAL_ENDPOINT=
# 先执行 configure-archive，预览就绪后自动标记原件深度冷归档。
OSS_ARCHIVE_ORIGINALS=true
UPLOAD_PART_SIZE=16777216
MAX_FILE_SIZE=53687091200
SESSION_HOURS=168

# 可选：智能找回忆。启用后后台将发送压缩画面至 OpenAI 官方 API。
AI_SEARCH_ENABLED=false
# 后台画面分析；在线搜索固定使用快速模型 gpt-4.1-mini。
AI_ANALYSIS_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
# 可选，仅 OpenAI 请求使用此代理；服务器本机 Clash 示例：http://127.0.0.1:7890
OPENAI_PROXY_URL=
AI_MONTHLY_BUDGET_USD=80

# 可选：本地 CPU 人脸匹配，需安装 requirements-faces.txt 并运行 setup-face-models。
FACE_MATCHING_ENABLED=false
# 仅用人工确认的样本自动关联高相似人脸；默认关闭。
FACE_AUTO_LINK_ENABLED=false
# FACE_MODEL_DIRECTORY=/var/lib/yearly/face-models
FACE_MATCH_THRESHOLD=0.45
