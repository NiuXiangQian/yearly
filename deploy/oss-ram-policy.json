{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:AbortMultipartUpload",
        "oss:ListParts"
      ],
      "Resource": [
        "acs:oss:*:*:your-private-bucket/originals/*",
        "acs:oss:*:*:your-private-bucket/previews/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetObjectTagging", "oss:PutObjectTagging", "oss:RestoreObject"],
      "Resource": ["acs:oss:*:*:your-private-bucket/originals/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetBucketLifecycle", "oss:PutBucketLifecycle"],
      "Resource": ["acs:oss:*:*:your-private-bucket"]
    }
  ]
}
